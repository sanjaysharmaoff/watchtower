# WatchTower configuration.
#
# Every value below is optional. The defaults boot a fully working instance with no
# infrastructure at all: in-memory storage, a rule-based planner, synthetic context
# and email printed to stdout. Change one driver at a time.
#
# Copy to .env and edit. Both WT_ prefixed and unprefixed names are read, WT_ wins.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
WT_ENV=dev                       # dev | prod (prod enforces auth token and approval secret)
WT_LOG_LEVEL=info                # debug | info | warn | error
WT_LOG_FORMAT=text               # text | json

# ---------------------------------------------------------------------------
# Inbound edge
# ---------------------------------------------------------------------------
WT_HTTP_ADDR=:8080
WT_HTTP_AUTH_TOKEN=              # bearer token required on POST /alerts and POST /runbook/approve
WT_HTTP_MAX_BODY_BYTES=2097152
WT_PUBLIC_BASE_URL=http://localhost:8080
WT_APPROVAL_SECRET=watchtower-dev-secret   # signs the one-click links in emails
WT_APPROVAL_TTL=168h
WT_ALERT_DECODER=alertmanager    # alertmanager | generic

# ---------------------------------------------------------------------------
# Ingestion: worker pool, debounce, correlation
# ---------------------------------------------------------------------------
WT_WORKERS=8
WT_QUEUE_SIZE=512
WT_JOB_TIMEOUT=3m
WT_GATE_DRIVER=memory            # memory | redis (use redis with more than one replica)
WT_DEBOUNCE_WINDOW=1h
WT_DROP_RESOLVED=true
WT_MIN_SEVERITY=warning          # floor: info | warning | critical
WT_CORRELATION_KEYS=cluster,namespace,service
WT_CORRELATION_WINDOW=5m

# ---------------------------------------------------------------------------
# Enrichment
# ---------------------------------------------------------------------------
WT_ENRICH_PROVIDERS=demo         # comma separated: loki,k8s | demo | none
WT_ENRICH_TIMEOUT=8s
WT_ENRICH_LOG_LIMIT=100
WT_ENRICH_LOOKBACK=15m

WT_LOKI_URL=
WT_LOKI_TENANT=
WT_LOKI_USERNAME=
WT_LOKI_PASSWORD=
# Optional LogQL override. {{namespace}}, {{service}} and {{cluster}} are substituted.
WT_LOKI_QUERY=

WT_K8S_API_SERVER=               # defaults to https://kubernetes.default.svc in-cluster
WT_K8S_TOKEN=                    # defaults to the mounted service account token
WT_K8S_CA_FILE=
WT_K8S_INSECURE=false
WT_K8S_EVENT_LIMIT=40

# ---------------------------------------------------------------------------
# Sanitizer chain (order matters)
# ---------------------------------------------------------------------------
WT_SANITIZE_CHAIN=dedupe,signal,compress,cap
WT_SANITIZE_MAX_LINES=60
WT_SANITIZE_MAX_LINE_LEN=400
WT_SANITIZE_MIN_LEVEL=warn
WT_SANITIZE_KEYWORDS=error,fail,timeout,refused,panic,oom,exception,denied,unavailable
WT_SANITIZE_STRIP_DIGITS=true

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
WT_EMBEDDER_DRIVER=stub          # stub (offline hashing, 256 dims) | openai
WT_VECTOR_DRIVER=memory          # memory | postgres (pgvector)
WT_RERANK_DRIVER=heuristic       # heuristic (free) | llm | none
WT_CACHE_DRIVER=memory           # memory | redis | none
WT_RAG_TOP_K=10
WT_RAG_TOP_N=2
WT_RAG_MIN_SCORE=0.2
WT_RAG_CACHE_TTL=24h
WT_VECTOR_DIMS=1536              # must match the embedder: 1536 for openai small, 256 for stub

WT_REDIS_ADDR=localhost:6379
WT_REDIS_PASSWORD=
WT_REDIS_DB=0

# ---------------------------------------------------------------------------
# Cognitive core
# ---------------------------------------------------------------------------
WT_LLM_PROVIDER=stub             # stub (offline rules) | openai
WT_LLM_BASE_URL=https://api.openai.com/v1
WT_OPENAI_API_KEY=
WT_PLANNER_MODEL=gpt-4o-mini
WT_CRITIC_MODEL=gpt-4o-mini
WT_EMBED_MODEL=text-embedding-3-small
WT_LLM_TEMPERATURE=0.1
WT_LLM_MAX_TOKENS=1400
WT_LLM_TIMEOUT=45s
WT_LLM_MAX_ATTEMPTS=2            # planner/critic self-correction rounds
WT_LLM_CRITIC_ENABLED=true

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
WT_INPUT_REDACTORS=secrets,pii,custom
WT_INPUT_REDACT_PATTERNS=        # extra regexes, comma separated
WT_OUTPUT_INSPECTORS=denylist,flags,allowlist
WT_GUARD_DENY_PATTERNS=          # extra destructive-command regexes
WT_GUARD_DENY_FLAGS=             # extra dangerous flags
WT_GUARD_ALLOW_BINARIES=         # empty uses the curated default tool set
WT_GUARD_MODE=strip              # strip (remove the command, keep the plan) | halt (drop the incident)

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
WT_STORE_DRIVER=memory           # memory | postgres
WT_POSTGRES_DSN=                 # postgres://watchtower:secret@localhost:5432/watchtower?sslmode=disable
WT_POSTGRES_MAX_CONNS=10
WT_STORE_AUTO_MIGRATE=true       # false if you apply migrations/001_init.sql yourself
WT_STORE_RETENTION_DAYS=30
WT_STORE_PARTITION_AHEAD=7
WT_STORE_MEMORY_LIMIT=500

# ---------------------------------------------------------------------------
# Delivery
# ---------------------------------------------------------------------------
WT_NOTIFY_DRIVER=stdout          # stdout | smtp | none | memory
WT_RENDERER=html
WT_MAIL_FROM=watchtower@example.com
WT_MAIL_TO=sre@example.com
WT_SMTP_HOST=                    # email-smtp.eu-west-1.amazonaws.com for SES
WT_SMTP_PORT=587
WT_SMTP_USERNAME=
WT_SMTP_PASSWORD=
WT_SMTP_TLS=true
WT_NOTIFY_MIN_CONFIDENCE=0       # suppress email below this confidence (incident is still stored)

# ---------------------------------------------------------------------------
# Schedules
# ---------------------------------------------------------------------------
WT_CRON_ENABLED=true
WT_CRON_TZ=UTC
WT_CRON_PARTITION_SPEC=0 0 * * *
WT_CRON_DIGEST_SPEC=0 8 * * *
WT_DIGEST_WINDOW=24h

# ---------------------------------------------------------------------------
# Internals
# ---------------------------------------------------------------------------
WT_BUS_BUFFER=512
WT_BUS_WORKERS=4
WT_STAGE_TIMEOUT=60s
